# ============================================
# CONFIGURAÇÃO DA API
# ============================================
# 
# Este arquivo define a URL base da API para o aplicativo mobile.
# 
# IMPORTANTE:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Ajuste o IP para o IP da sua máquina
# 3. Reinicie o Expo: npm start
#
# ============================================

# URL da API (ajuste o IP para sua rede local)
# Descubra seu IP com:
# - Mac/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
# - Windows: ipconfig

EXPO_PUBLIC_API_URL=http://192.168.15.1:3000

# ============================================
# NOTAS:
# ============================================
# 
# Se não definir esta variável, o app usará:
# - Android Emulator: http://10.0.2.2:3000
# - iOS Simulator: http://localhost:3000
# - Dispositivos Físicos: http://192.168.15.1:3000 (IP configurado no código)
#
# ============================================
