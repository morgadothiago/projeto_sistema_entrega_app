# API Configuration
# IMPORTANTE: Copie este arquivo para .env e configure suas variáveis

# URL base da API (development)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Timeout da API em milissegundos
EXPO_PUBLIC_API_TIMEOUT=10000

# External APIs
EXPO_PUBLIC_VIA_CEP_API_URL=https://viacep.com.br/ws

# Ambiente
NODE_ENV=development

# ========================================
# PRODUÇÃO - Descomente e configure antes de publicar
# ========================================
# EXPO_PUBLIC_API_URL=https://api.seudominio.com
# NODE_ENV=production
