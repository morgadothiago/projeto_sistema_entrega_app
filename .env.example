# ========================================
# Exemplo de Variáveis de Ambiente
# ========================================
# Copiar para .env e preencher com valores reais
# NUNCA commitar arquivos .env com dados reais!

# ========================================
# AMBIENTE
# ========================================
# Valores: development | test | staging | production
APP_ENV=development

# ========================================
# API CONFIGURATION
# ========================================

# Development
API_URL_DEV=http://localhost:3000/api
WS_URL_DEV=ws://localhost:3000

# Test
API_URL_TEST=https://api-test.seudominio.com.br/api
WS_URL_TEST=wss://api-test.seudominio.com.br

# Staging
API_URL_STAGING=https://api-staging.seudominio.com.br/api
WS_URL_STAGING=wss://api-staging.seudominio.com.br

# Production
API_URL_PROD=https://api.seudominio.com.br/api
WS_URL_PROD=wss://api.seudominio.com.br

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_TRACKING=true

# ========================================
# THIRD PARTY SERVICES
# ========================================

# Google Maps (se necessário)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Analytics (se usar)
MIXPANEL_TOKEN=your_mixpanel_token
AMPLITUDE_KEY=your_amplitude_key

# Crash Reporting (se usar Sentry)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development

# Push Notifications
ONESIGNAL_APP_ID=your_onesignal_app_id

# ========================================
# DEBUG OPTIONS
# ========================================
DEBUG_MODE=true
LOG_LEVEL=debug
ENABLE_REDUX_DEVTOOLS=true
